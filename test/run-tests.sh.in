#!/bin/sh
# Run the test cases with ctest, or run one test app directly.
#
# Usage, from the install test directory after an install:
#   ./run-tests.sh                Run every test case on every driver that this machine has.
#   ./run-tests.sh -L smoke       Pass every argument to ctest. Examples: -L <label>, -R <regex>, -j 4.
#   ./run-tests.sh triangle       Run one test app on the mock ICD, without the runner and without a
#                                 comparison.
#   GFXRECON_TEST_DRIVER=lavapipe ./run-tests.sh -L smoke
#                                 Run on one driver only: mock, lavapipe, or all, the default.
#                                 Works with every mode. The single app mode takes all as mock.
#
# A plain "ctest --test-dir <build>/test" also works, because CMake gives every test case the
# same environment. This script adds the run over every driver and the single app mode.
#
# CMake generates this file from test/run-tests.sh.in. Edit the template, not this file. The
# environment comes from GFXRECON_TEST_ENVIRONMENT in test/CMakeLists.txt.

@GFXRECON_TEST_ENVIRONMENT_EXPORTS@
#export GFXRECON_LOG_LEVEL="info"
#export VK_LOADER_DEBUG="all"

CTEST="@CMAKE_CTEST_COMMAND@"
TEST_BUILD_DIR="@GFXRECON_TEST_BUILD_DIR@"
LAVAPIPE_ICD_JSON="@GFXRECON_TEST_LAVAPIPE_ICD_JSON@"

# A multi-config generator needs the configuration. A single-config generator ignores it.
CTEST_CONFIG="$<CONFIG>"
CONFIG_ARGS=""
if [ -n "$CTEST_CONFIG" ]; then
    CONFIG_ARGS="-C $CTEST_CONFIG"
fi

# True when the machine has the driver. The mock is built with the tests, so it is always there.
have_driver() {
    case "$1" in
        mock) return 0 ;;
        lavapipe) [ -n "$LAVAPIPE_ICD_JSON" ] && [ -f "$LAVAPIPE_ICD_JSON" ] ;;
        *) return 1 ;;
    esac
}

# Export the environment for one driver. ctest reads GFXRECON_TEST_DRIVER, which is in each list,
# through test_environment.cmake. The single app mode needs the exports themselves.
select_driver() {
    case "$1" in
        mock)
@GFXRECON_TEST_ENVIRONMENT_MOCK_EXPORTS@
            JUNIT_FILE="ctest-results.xml"
            ;;
        lavapipe)
@GFXRECON_TEST_ENVIRONMENT_LAVAPIPE_EXPORTS@
            JUNIT_FILE="ctest-results-lavapipe.xml"
            ;;
    esac
}

# Run ctest on one driver. ctest also writes a JUnit file next to the captures, for CI reports.
# The name carries the driver, so a run on the mock and a run on lavapipe do not overwrite each
# other.
run_ctest() {
    driver="$1"
    shift
    if ! have_driver "$driver"; then
        echo "No lavapipe manifest at \"$LAVAPIPE_ICD_JSON\". Install mesa-vulkan-drivers, or configure" >&2
        echo "with -DGFXRECON_TEST_LAVAPIPE_ICD_JSON=<path>." >&2
        return 1
    fi
    select_driver "$driver"
    echo "==== Test driver: $driver ===="
    "$CTEST" --test-dir "$TEST_BUILD_DIR" $CONFIG_ARGS --output-on-failure \
        --output-junit "$PWD/$JUNIT_FILE" "$@"
}

DRIVER="${GFXRECON_TEST_DRIVER:-all}"
case "$DRIVER" in
    mock | lavapipe | all) ;;
    *)
        echo "GFXRECON_TEST_DRIVER is \"$DRIVER\". Use mock, lavapipe or all." >&2
        exit 1
        ;;
esac

case "$1" in
    "" | -*)
        if [ "$DRIVER" != "all" ]; then
            run_ctest "$DRIVER" "$@"
            exit $?
        fi
        # Every driver that the machine has. A missing lavapipe is a note, not a failure.
        STATUS=0
        run_ctest mock "$@" || STATUS=1
        if have_driver lavapipe; then
            run_ctest lavapipe "$@" || STATUS=1
        else
            echo "==== Test driver: lavapipe not found at \"$LAVAPIPE_ICD_JSON\", skipped ===="
        fi
        exit $STATUS
        ;;
    *)
        if [ "$DRIVER" = "all" ]; then
            DRIVER=mock
        fi
        if ! have_driver "$DRIVER"; then
            echo "No lavapipe manifest at \"$LAVAPIPE_ICD_JSON\"." >&2
            exit 1
        fi
        select_driver "$DRIVER"
        TEST_DIR="$PWD"
        cd "$TEST_DIR/res" && exec "$TEST_DIR/test_apps/launcher/gfxrecon-test-launcher" "$1"
        ;;
esac
