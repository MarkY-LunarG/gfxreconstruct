#!/bin/sh
# Run the test cases with ctest, or run one test app directly.
#
# Usage, from the install test directory after an install:
#   ./run-tests.sh                Run every test case.
#   ./run-tests.sh -L smoke       Pass every argument to ctest. Examples: -L <label>, -R <regex>, -j 4.
#   ./run-tests.sh triangle       Run one test app without the runner and without a comparison.
#   GFXRECON_TEST_DRIVER=lavapipe ./run-tests.sh -L smoke
#                                 Run on lavapipe instead of the mock ICD. Works with every mode.
#
# A plain "ctest --test-dir <build>/test" also works, because CMake gives every test case the
# same environment. This script adds the single app mode.
#
# CMake generates this file from test/run-tests.sh.in. Edit the template, not this file. The
# environment comes from GFXRECON_TEST_ENVIRONMENT in test/CMakeLists.txt.

@GFXRECON_TEST_ENVIRONMENT_EXPORTS@
# GFXRECON_TEST_DRIVER selects the driver: mock, the default, or lavapipe. ctest reads it through
# test_environment.cmake. The single app mode reads it here.
case "${GFXRECON_TEST_DRIVER:-mock}" in
    mock)
@GFXRECON_TEST_ENVIRONMENT_MOCK_EXPORTS@
        JUNIT_FILE="ctest-results.xml"
        ;;
    lavapipe)
@GFXRECON_TEST_ENVIRONMENT_LAVAPIPE_EXPORTS@
        JUNIT_FILE="ctest-results-lavapipe.xml"
        if [ -z "$VK_DRIVER_FILES" ]; then
            echo "No lavapipe manifest is configured. Configure with -DGFXRECON_TEST_LAVAPIPE_ICD_JSON=<path>." >&2
            exit 1
        fi
        ;;
    *)
        echo "GFXRECON_TEST_DRIVER is \"$GFXRECON_TEST_DRIVER\". Use mock or lavapipe." >&2
        exit 1
        ;;
esac
#export GFXRECON_LOG_LEVEL="info"
#export VK_LOADER_DEBUG="all"

CTEST="@CMAKE_CTEST_COMMAND@"
TEST_BUILD_DIR="@GFXRECON_TEST_BUILD_DIR@"

# A multi-config generator needs the configuration. A single-config generator ignores it.
CTEST_CONFIG="$<CONFIG>"
CONFIG_ARGS=""
if [ -n "$CTEST_CONFIG" ]; then
    CONFIG_ARGS="-C $CTEST_CONFIG"
fi

case "$1" in
    "" | -*)
        # ctest also writes a JUnit file next to the captures, for CI reports. The name carries
        # the driver, so a run on the mock and a run on lavapipe do not overwrite each other.
        exec "$CTEST" --test-dir "$TEST_BUILD_DIR" $CONFIG_ARGS --output-on-failure \
            --output-junit "$PWD/$JUNIT_FILE" "$@"
        ;;
    *)
        TEST_DIR="$PWD"
        cd "$TEST_DIR/res" && exec "$TEST_DIR/test_apps/launcher/gfxrecon-test-launcher" "$1"
        ;;
esac
