# ctest reads this file after the discovery file for gfxrecon-testapp-runner. That file sets
# GFXRECON_TESTAPP_TESTS to the list of discovered cases. Give every case the loader environment,
# so a plain ctest run works without the run-tests script.
#
# GFXRECON_TEST_DRIVER in the environment of the ctest process selects the driver. It is "mock",
# the default, or "lavapipe". This file runs at ctest time, so a switch of driver needs no
# reconfigure. A shell export of VK_DRIVER_FILES alone does not work, because the ENVIRONMENT
# property that this file sets replaces it.
#
# CMake generates this file from test/test_environment.cmake.in. Edit the template, not this file.

if (GFXRECON_TESTAPP_TESTS)
    set(driver "$ENV{GFXRECON_TEST_DRIVER}")
    if (driver STREQUAL "")
        set(driver "mock")
    endif ()

    set(environment "@GFXRECON_TEST_ENVIRONMENT@")
    if (driver STREQUAL "mock")
        list(APPEND environment "@GFXRECON_TEST_ENVIRONMENT_MOCK@")
    elseif (driver STREQUAL "lavapipe")
        if ("@GFXRECON_TEST_LAVAPIPE_ICD_JSON@" STREQUAL "")
            message(FATAL_ERROR "GFXRECON_TEST_DRIVER is lavapipe, but no lavapipe manifest is "
                                "configured. Configure with -DGFXRECON_TEST_LAVAPIPE_ICD_JSON=<path>.")
        endif ()
        list(APPEND environment "@GFXRECON_TEST_ENVIRONMENT_LAVAPIPE@")
    else ()
        message(FATAL_ERROR "GFXRECON_TEST_DRIVER is \"${driver}\". Use mock or lavapipe.")
    endif ()

    set_tests_properties(${GFXRECON_TESTAPP_TESTS} PROPERTIES ENVIRONMENT "${environment}")

    # Label every case by the driver it needs, next to the "smoke" label from discovery. A case
    # whose name matches one of the mock-only patterns is "mock-only". A case that matches the
    # real-driver pattern is "real-driver". Every other case is "any-driver". A case whose driver
    # is not the current one is disabled, so ctest reports it as not run and the run passes on
    # what holds.
    set(mock_only_patterns
        # A known-good file is a capture on the mock, so a comparison against it holds there only.
        "CorrectGFXR"
        # The hardware buffer that the ahb app imports is the host mock in android_mock/.
        "^AndroidHardwareBuffer[.]" "/ahb$"
        # Lavapipe does not have VK_KHR_pipeline_binary.
        "^PipelineBinaries[.]" "/pipeline_binaries$"
        # Lavapipe does not have VK_KHR_present_wait.
        "^WaitForPresent[.]" "/wait_for_present$"
        # The app faults on lavapipe in a write to memory from vkMapMemory. Remove when it is fixed.
        "^SerializeComputeAndTransfer[.]" "/serialize_compute_and_transfer$")

    set(real_driver_patterns
        # The pixel comparisons. The mock draws nothing, so they need a driver that executes shaders.
        "^RealDriverApps/Screenshot[.]"
        # Capture on one driver and replay on the other. The mock is always there, lavapipe is not.
        "^CrossDriver[.]")

    foreach (test IN LISTS GFXRECON_TESTAPP_TESTS)
        set(driver_label "any-driver")
        foreach (pattern IN LISTS mock_only_patterns)
            if (test MATCHES "${pattern}")
                set(driver_label "mock-only")
                break()
            endif ()
        endforeach ()
        foreach (pattern IN LISTS real_driver_patterns)
            if (test MATCHES "${pattern}")
                set(driver_label "real-driver")
                break()
            endif ()
        endforeach ()
        set_tests_properties(${test} PROPERTIES LABELS "smoke;${driver_label}")
        if ((driver_label STREQUAL "mock-only" AND NOT driver STREQUAL "mock") OR
            (driver_label STREQUAL "real-driver" AND driver STREQUAL "mock"))
            set_tests_properties(${test} PROPERTIES DISABLED TRUE)
        endif ()
    endforeach ()
endif ()
